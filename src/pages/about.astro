---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { HeartHandshake, Cpu, MapPin, Phone } from 'lucide-astro';
---
<Layout title="About | SmartByteKC">
  <Header />
  <main class="bg-slate-950 min-h-screen">
    <div class="max-w-7xl mx-auto px-6 py-24 sm:py-32">
      <div class="max-w-3xl">
        <h1 class="text-5xl sm:text-7xl font-extrabold text-white tracking-tight mb-8">
          About <span class="text-emerald-400">SmartByteKC</span>
        </h1>
        <p class="text-xl sm:text-2xl text-slate-300 mb-12 leading-relaxed font-medium">
          We're your local Kansas City technology partner. We design, install, and support networks, security systems, audio/video, and smart home technology — explained in plain English, built to last.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 mb-20">
        <div class="bg-slate-900/50 p-10 rounded-3xl border border-slate-800 backdrop-blur-md">
          <div class="w-16 h-16 rounded-2xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center mb-8">
            <HeartHandshake class="w-8 h-8" />
          </div>
          <h2 class="text-2xl font-bold text-white mb-4">We Explain, Never Confuse</h2>
          <p class="text-lg text-slate-400">
            Every recommendation is broken down in plain English. You'll know exactly what you're paying for, why you need it, and how it works — before you spend a dime.
          </p>
        </div>

        <div class="bg-slate-900/50 p-10 rounded-3xl border border-slate-800 backdrop-blur-md">
          <div class="w-16 h-16 rounded-2xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center mb-8">
            <Cpu class="w-8 h-8" />
          </div>
          <h2 class="text-2xl font-bold text-white mb-4">Engineering-Grade Thinking</h2>
          <p class="text-lg text-slate-400">
            Built on a background in control systems engineering. We design with precision, plan for future upgrades, and install hardware that stands the test of time.
          </p>
        </div>

        <div class="bg-slate-900/50 p-10 rounded-3xl border border-slate-800 backdrop-blur-md">
          <div class="w-16 h-16 rounded-2xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center mb-8">
            <MapPin class="w-8 h-8" />
          </div>
          <h2 class="text-2xl font-bold text-white mb-4">100% Local Kansas City</h2>
          <p class="text-lg text-slate-400">
            We're your neighbors, not a distant call center. Fast response times, honest pricing, and a commitment to making KC homes and businesses smarter.
          </p>
        </div>
      </div>

      <div class="bg-slate-900/50 p-10 sm:p-16 rounded-3xl border border-slate-800 text-center">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white mb-6">Ready to get started?</h2>
        <p class="text-lg text-slate-400 mb-10 max-w-2xl mx-auto">
          Call Vince directly to discuss your project, or fill out the contact form on our homepage. We'll walk you through your options and put together a plan that fits.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="tel:+19137035643" class="inline-flex items-center justify-center gap-3 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black px-10 py-5 rounded-full text-lg shadow-glow">
            <Phone class="w-5 h-5" />
            (913) 703-5643
          </a>
          <a href="/#contact" class="inline-flex items-center justify-center gap-3 bg-slate-800 hover:bg-slate-700 text-white font-bold px-10 py-5 rounded-full text-lg border border-slate-700">
            Request Consultation
          </a>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>