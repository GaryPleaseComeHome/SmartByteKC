---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { Tv, Music, MonitorSpeaker, Projector } from 'lucide-astro';
---
<Layout title="Audio / Video | SmartByteKC">
  <Header />
  <main class="bg-slate-950 min-h-screen">
    <div class="max-w-7xl mx-auto px-6 py-24 sm:py-32">
      <div class="max-w-3xl">
        <h1 class="text-5xl sm:text-7xl font-extrabold text-white tracking-tight mb-8">
          <span class="text-emerald-400">Audio</span> / <span class="text-emerald-400">Video</span> Systems
        </h1>
        <p class="text-xl sm:text-2xl text-slate-300 mb-12 leading-relaxed font-medium">
          Transform your space with immersive entertainment. We design and install concealed TV mounts, high-fidelity sound systems, and multi-room audio — all tailored to your home or business.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-12 mb-20">
        <div class="bg-slate-900/50 p-10 rounded-3xl border border-slate-800 backdrop-blur-md">
          <div class="w-16 h-16 rounded-2xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center mb-8">
            <Tv class="w-8 h-8" />
          </div>
          <h2 class="text-3xl font-bold text-white mb-6">TV Mounting & Setup</h2>
          <p class="text-lg text-slate-400 mb-6">
            Clean, professional TV mounting with all wires hidden inside the wall. We handle everything from bracket selection to cable concealment and picture calibration.
          </p>
          <ul class="space-y-4 text-slate-300 font-bold">
            <li class="flex items-center gap-3"><div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div> In-Wall Wire Concealment</li>
            <li class="flex items-center gap-3"><div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div> Fixed, Tilt & Articulating Mounts</li>
            <li class="flex items-center gap-3"><div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div> Soundbar Integration</li>
            <li class="flex items-center gap-3"><div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div> Picture Calibration & Setup</li>
          </ul>
        </div>

        <div class="bg-slate-900/50 p-10 rounded-3xl border border-slate-800 backdrop-blur-md">
          <div class="w-16 h-16 rounded-2xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center mb-8">
            <MonitorSpeaker class="w-8 h-8" />
          </div>
          <h2 class="text-3xl font-bold text-white mb-6">Home Theater</h2>
          <p class="text-lg text-slate-400 mb-6">
            Custom home theater design and installation for a true cinema experience. From surround sound speaker placement to dedicated media rooms, we build it right.
          </p>
          <ul class="space-y-4 text-slate-300 font-bold">
            <li class="flex items-center gap-3"><div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div> 5.1 / 7.1 Surround Sound</li>
            <li class="flex items-center gap-3"><div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div> Dolby Atmos Configuration</li>
            <li class="flex items-center gap-3"><div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div> Projector & Screen Setup</li>
            <li class="flex items-center gap-3"><div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div> Acoustic Treatment Planning</li>
          </ul>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-12 mb-20">
        <div class="bg-slate-900/50 p-10 rounded-3xl border border-slate-800 backdrop-blur-md">
          <div class="w-16 h-16 rounded-2xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center mb-8">
            <Music class="w-8 h-8" />
          </div>
          <h2 class="text-3xl font-bold text-white mb-6">Multi-Room Audio</h2>
          <p class="text-lg text-slate-400 mb-6">
            Fill your entire home or business with music. We install ceiling speakers, outdoor audio zones, and smart-controlled multi-room systems you can manage from your phone.
          </p>
          <ul class="space-y-4 text-slate-300 font-bold">
            <li class="flex items-center gap-3"><div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div> In-Ceiling & In-Wall Speakers</li>
            <li class="flex items-center gap-3"><div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div> Outdoor Weatherproof Audio</li>
            <li class="flex items-center gap-3"><div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div> AirPlay / Chromecast Integration</li>
            <li class="flex items-center gap-3"><div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div> Whole-Home Audio Zones</li>
          </ul>
        </div>

        <div class="bg-slate-900/50 p-10 rounded-3xl border border-slate-800 backdrop-blur-md">
          <div class="w-16 h-16 rounded-2xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center mb-8">
            <Projector class="w-8 h-8" />
          </div>
          <h2 class="text-3xl font-bold text-white mb-6">Commercial AV</h2>
          <p class="text-lg text-slate-400 mb-6">
            Digital signage, conference room displays, restaurant audio, and commercial speaker systems — designed for durability and ease of daily use.
          </p>
          <ul class="space-y-4 text-slate-300 font-bold">
            <li class="flex items-center gap-3"><div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div> Digital Signage Displays</li>
            <li class="flex items-center gap-3"><div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div> Conference Room AV</li>
            <li class="flex items-center gap-3"><div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div> HDMI Matrix Switching</li>
            <li class="flex items-center gap-3"><div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div> Restaurant & Retail Audio</li>
          </ul>
        </div>
      </div>

      <div class="text-center">
        <a href="/#contact" class="inline-flex items-center justify-center gap-4 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black px-12 py-6 rounded-full text-xl shadow-glow transform hover:-translate-y-1 transition-all">
          Get an AV Quote
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>