---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Audio / Video | SmartByteKC">
  <div class="max-w-4xl mx-auto px-6 py-24 text-white">
    <h1 class="text-5xl font-extrabold mb-8 text-emerald-400">Audio / Video</h1>
    <p class="text-xl text-slate-300 mb-10 leading-relaxed">
      Transform your space with immersive entertainment. We specialize in concealed TV mounting, high-fidelity sound systems, and multi-room audio, all tailored to your specific architectural layout.
    </p>

    <h2 class="text-3xl font-bold mb-6">AV Solutions</h2>
    <ul class="list-disc list-inside text-lg text-slate-300 space-y-3 mb-10">
      <li>Professional TV Mounting (Hidden Wires)</li>
      <li>Custom Home Theater Design</li>
      <li>Multi-Room & Outdoor Audio Systems</li>
      <li>Smart Audio/Video Control Integration</li>
      <li>HDMI Signal Distribution Systems</li>
    </ul>

    <a href="#contact" class="inline-block bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black px-10 py-5 rounded-full text-lg shadow-glow">
      Request AV Quote
    </a>
  </div>
</Layout>