---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { Wifi, ShieldCheck, CheckCircle2, Phone, ArrowLeft } from 'lucide-astro';
---

<Layout 
	title="Network Security & Cat6 Cabling | SmartByteKC Kansas City"
	description="Enterprise-grade Wi-Fi 6E/7 mesh, structured Cat6 cabling, 4K security camera systems, and Ubiquiti UniFi access control in Kansas City."
>
	<Header />
	<main class="py-16 sm:py-24 bg-white">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
			<a href="/#services" class="inline-flex items-center gap-2 text-sm font-semibold text-brand-700 hover:text-brand-800 mb-8">
				<ArrowLeft class="w-4 h-4" />
				Back to All Services
			</a>

			<div class="w-14 h-14 rounded-2xl bg-brand-50 text-brand-700 flex items-center justify-center mb-6">
				<Wifi class="w-8 h-8" />
			</div>

			<h1 class="font-heading text-4xl sm:text-5xl font-extrabold text-dark tracking-tight">
				Network Security &amp; Cabling
			</h1>
			<p class="mt-4 text-xl text-grayMuted leading-relaxed">
				Zero dead zones, high throughput, and robust surveillance. We design and install rock-solid network infrastructure for Kansas City homes and business offices.
			</p>

			<div class="mt-12 space-y-8 border-t border-gray-100 pt-10">
				<div class="bg-grayLight p-8 rounded-3xl border border-gray-200">
					<h3 class="font-heading text-2xl font-bold text-dark mb-4">What We Cover</h3>
					<ul class="grid grid-cols-1 sm:grid-cols-2 gap-4">
						<li class="flex items-center gap-3 font-medium text-dark">
							<CheckCircle2 class="w-5 h-5 text-brand-600 shrink-0" />
							<span>Wi-Fi 6E / Wi-Fi 7 Mesh Deployments</span>
						</li>
						<li class="flex items-center gap-3 font-medium text-dark">
							<CheckCircle2 class="w-5 h-5 text-brand-600 shrink-0" />
							<span>Cat6 / Cat6A Structured Cabling</span>
						</li>
						<li class="flex items-center gap-3 font-medium text-dark">
							<CheckCircle2 class="w-5 h-5 text-brand-600 shrink-0" />
							<span>4K IP PoE Camera Systems &amp; Local NVRs</span>
						</li>
						<li class="flex items-center gap-3 font-medium text-dark">
							<CheckCircle2 class="w-5 h-5 text-brand-600 shrink-0" />
							<span>Door Access Control &amp; Keypads</span>
						</li>
						<li class="flex items-center gap-3 font-medium text-dark">
							<CheckCircle2 class="w-5 h-5 text-brand-600 shrink-0" />
							<span>Server Rack Cleanup &amp; Cable Dressing</span>
						</li>
						<li class="flex items-center gap-3 font-medium text-dark">
							<CheckCircle2 class="w-5 h-5 text-brand-600 shrink-0" />
							<span>VLAN Guest Network Isolation</span>
						</li>
					</ul>
				</div>

				<div class="bg-brand-900 text-white p-8 rounded-3xl flex flex-col sm:flex-row items-center justify-between gap-6">
					<div>
						<h4 class="font-heading text-2xl font-bold">Ready to upgrade your network?</h4>
						<p class="text-gray-300 text-sm mt-1">Get an exact on-site quote or instant estimate today.</p>
					</div>
					<a href="tel:+19137035643" class="inline-flex items-center gap-2 bg-brand-500 hover:bg-brand-600 text-white font-bold px-6 py-3.5 rounded-full text-sm shrink-0">
						<Phone class="w-4 h-4" />
						Call (913) 703-5643
					</a>
				</div>
			</div>
		</div>
	</main>
	<Footer />
</Layout>
