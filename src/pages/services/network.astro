---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { Wifi, Globe, Smartphone, Server } from 'lucide-astro';
---
<Layout title="Network Solutions | SmartByteKC">
  <Header />
  <main class="bg-slate-950 min-h-screen">
    <div class="max-w-7xl mx-auto px-6 py-24 sm:py-32">
      <div class="max-w-3xl">
        <h1 class="text-5xl sm:text-7xl font-extrabold text-white tracking-tight mb-8">
          Reliable <span class="text-emerald-400">Network</span> Solutions
        </h1>
        <p class="text-xl sm:text-2xl text-slate-300 mb-12 leading-relaxed font-medium">
          We engineer high-performance Wi-Fi and structured data solutions designed for zero dead zones, maximum bandwidth, and business-grade reliability.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-12 mb-20">
        <div class="bg-slate-900/50 p-10 rounded-3xl border border-slate-800 backdrop-blur-md">
          <div class="w-16 h-16 rounded-2xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center mb-8">
            <Wifi class="w-8 h-8" />
          </div>
          <h2 class="text-3xl font-bold text-white mb-6">Wi-Fi & Wireless</h2>
          <p class="text-lg text-slate-400 mb-6">
            Professional deployment of Wi-Fi 6E and Wi-Fi 7 mesh systems. We map your space to ensure seamless coverage in every room and outdoor area.
          </p>
          <ul class="space-y-4 text-slate-300 font-bold">
            <li class="flex items-center gap-3"><div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div> Mesh System Design</li>
            <li class="flex items-center gap-3"><div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div> Outdoor Extension</li>
            <li class="flex items-center gap-3"><div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div> Guest Network isolation</li>
          </ul>
        </div>

        <div class="bg-slate-900/50 p-10 rounded-3xl border border-slate-800 backdrop-blur-md">
          <div class="w-16 h-16 rounded-2xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center mb-8">
            <Server class="w-8 h-8" />
          </div>
          <h2 class="text-3xl font-bold text-white mb-6">Structured Cabling</h2>
          <p class="text-lg text-slate-400 mb-6">
            The foundation of a reliable network. We install professional Cat6/Cat6A cabling for workstation drops, server racks, and high-demand devices.
          </p>
          <ul class="space-y-4 text-slate-300 font-bold">
            <li class="flex items-center gap-3"><div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div> Rack Cleanup & Setup</li>
            <li class="flex items-center gap-3"><div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div> Wall Plate Terminations</li>
            <li class="flex items-center gap-3"><div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div> Fiber Uplinks</li>
          </ul>
        </div>
      </div>

      <div class="text-center">
        <a href="/#contact" class="inline-flex items-center justify-center gap-4 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black px-12 py-6 rounded-full text-xl shadow-glow transform hover:-translate-y-1 transition-all">
          Get a Network Quote
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>