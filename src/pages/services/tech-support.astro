---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { Wrench, Wifi, Home, Monitor } from 'lucide-astro';
---
<Layout title="Tech Support | SmartByteKC">
  <Header />
  <main class="bg-slate-950 min-h-screen">
    <div class="max-w-7xl mx-auto px-6 py-24 sm:py-32">
      <div class="max-w-3xl">
        <h1 class="text-5xl sm:text-7xl font-extrabold text-white tracking-tight mb-8">
          Expert <span class="text-emerald-400">Tech Support</span>
        </h1>
        <p class="text-xl sm:text-2xl text-slate-300 mb-12 leading-relaxed font-medium">
          Technology should make your life easier, not harder. When something isn't working — or you need help setting up something new — we provide fast, plain-English troubleshooting for homes and businesses.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-12 mb-20">
        <div class="bg-slate-900/50 p-10 rounded-3xl border border-slate-800 backdrop-blur-md">
          <div class="w-16 h-16 rounded-2xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center mb-8">
            <Wifi class="w-8 h-8" />
          </div>
          <h2 class="text-3xl font-bold text-white mb-6">Network Troubleshooting</h2>
          <p class="text-lg text-slate-400 mb-6">
            Slow Wi-Fi? Dead zones? Devices dropping off? We diagnose and fix network issues quickly — from home routers to complex commercial setups.
          </p>
          <ul class="space-y-4 text-slate-300 font-bold">
            <li class="flex items-center gap-3"><div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div> Wi-Fi Dead Zone Diagnosis</li>
            <li class="flex items-center gap-3"><div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div> Router & Modem Configuration</li>
            <li class="flex items-center gap-3"><div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div> Bandwidth & Speed Optimization</li>
            <li class="flex items-center gap-3"><div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div> Device Connectivity Issues</li>
          </ul>
        </div>

        <div class="bg-slate-900/50 p-10 rounded-3xl border border-slate-800 backdrop-blur-md">
          <div class="w-16 h-16 rounded-2xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center mb-8">
            <Home class="w-8 h-8" />
          </div>
          <h2 class="text-3xl font-bold text-white mb-6">Smart Home Setup</h2>
          <p class="text-lg text-slate-400 mb-6">
            Getting into smart home tech can feel overwhelming. We set up and configure smart hubs, lights, thermostats, locks, and voice assistants so everything works together seamlessly.
          </p>
          <ul class="space-y-4 text-slate-300 font-bold">
            <li class="flex items-center gap-3"><div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div> Apple Home / Google Home Setup</li>
            <li class="flex items-center gap-3"><div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div> Smart Thermostat Installation</li>
            <li class="flex items-center gap-3"><div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div> Smart Lock & Garage Configuration</li>
            <li class="flex items-center gap-3"><div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div> Automation Routine Design</li>
          </ul>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-12 mb-20">
        <div class="bg-slate-900/50 p-10 rounded-3xl border border-slate-800 backdrop-blur-md">
          <div class="w-16 h-16 rounded-2xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center mb-8">
            <Monitor class="w-8 h-8" />
          </div>
          <h2 class="text-3xl font-bold text-white mb-6">PC & Workstation Help</h2>
          <p class="text-lg text-slate-400 mb-6">
            From slow machines to new setups, we handle PC and Mac troubleshooting, software configuration, data migration, and performance optimization.
          </p>
          <ul class="space-y-4 text-slate-300 font-bold">
            <li class="flex items-center gap-3"><div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div> PC & Mac Troubleshooting</li>
            <li class="flex items-center gap-3"><div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div> New Device Setup & Transfer</li>
            <li class="flex items-center gap-3"><div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div> Data Backup & Migration</li>
            <li class="flex items-center gap-3"><div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div> Printer & Peripheral Setup</li>
          </ul>
        </div>

        <div class="bg-slate-900/50 p-10 rounded-3xl border border-slate-800 backdrop-blur-md">
          <div class="w-16 h-16 rounded-2xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center mb-8">
            <Wrench class="w-8 h-8" />
          </div>
          <h2 class="text-3xl font-bold text-white mb-6">Emergency On-Site Help</h2>
          <p class="text-lg text-slate-400 mb-6">
            When you need help fast, we offer same-day and emergency on-site tech support across the Kansas City metro. No call centers — you talk directly to your tech.
          </p>
          <ul class="space-y-4 text-slate-300 font-bold">
            <li class="flex items-center gap-3"><div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div> Same-Day Appointments</li>
            <li class="flex items-center gap-3"><div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div> Direct Access to Your Technician</li>
            <li class="flex items-center gap-3"><div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div> Residential & Commercial Visits</li>
            <li class="flex items-center gap-3"><div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div> No Fix, No Fee Guarantee</li>
          </ul>
        </div>
      </div>

      <div class="text-center">
        <a href="/#contact" class="inline-flex items-center justify-center gap-4 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black px-12 py-6 rounded-full text-xl shadow-glow transform hover:-translate-y-1 transition-all">
          Schedule Support
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>