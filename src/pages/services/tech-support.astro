---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Tech Support | SmartByteKC">
  <div class="max-w-4xl mx-auto px-6 py-24 text-white">
    <h1 class="text-5xl font-extrabold mb-8 text-emerald-400">Tech Support</h1>
    <p class="text-xl text-slate-300 mb-10 leading-relaxed">
      Technology should make your life easier, not harder. If something isn't working, or you need guidance on your next setup, we provide expert, plain-English troubleshooting for residential and business technology.
    </p>

    <h2 class="text-3xl font-bold mb-6">Support Services</h2>
    <ul class="list-disc list-inside text-lg text-slate-300 space-y-3 mb-10">
      <li>Fast Network & Wi-Fi Troubleshooting</li>
      <li>Smart Home Device Setup & Integration</li>
      <li>PC / Mac / Workstation Optimization</li>
      <li>Device Migration & Data Backup</li>
      <li>Emergency On-Site Tech Assistance</li>
    </ul>

    <a href="#contact" class="inline-block bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black px-10 py-5 rounded-full text-lg shadow-glow">
      Schedule Support
    </a>
  </div>
</Layout>