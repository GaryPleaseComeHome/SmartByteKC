---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Security Systems | SmartByteKC">
  <div class="max-w-4xl mx-auto px-6 py-24 text-white">
    <h1 class="text-5xl font-extrabold mb-8 text-emerald-400">Security Systems</h1>
    <p class="text-xl text-slate-300 mb-10 leading-relaxed">
      Keep your home or business protected with expert surveillance installations. We supply and configure professional 4K IP security cameras, Network Video Recorders (NVRs), and modern access control systems for ultimate peace of mind.
    </p>

    <h2 class="text-3xl font-bold mb-6">Security Solutions</h2>
    <ul class="list-disc list-inside text-lg text-slate-300 space-y-3 mb-10">
      <li>4K IP Security Camera System Design</li>
      <li>Local NVR Recording with No Monthly Fees</li>
      <li>Smart Access Control (UniFi, Door Access)</li>
      <li>Commercial Security Audits & Upgrades</li>
      <li>Remote Mobile App Monitoring Setup</li>
    </ul>

    <a href="#contact" class="inline-block bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black px-10 py-5 rounded-full text-lg shadow-glow">
      Request Security Quote
    </a>
  </div>
</Layout>