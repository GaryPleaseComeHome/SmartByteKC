---
import Logo from './Logo.astro';
import { Phone, Mail, MapPin, ShieldCheck } from 'lucide-astro';
---

<footer class="bg-slate-950 text-white pt-16 pb-12 border-t border-slate-900">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-16">

			<!-- Column 1: Brand -->
			<div class="md:col-span-2 space-y-4">
				<a href="/" class="flex items-center gap-3.5">
					<div class="w-12 h-12 rounded-2xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center border border-emerald-500/30 shadow-glow shrink-0">
						<Logo class="w-8 h-8" />
					</div>
					<span class="font-heading font-extrabold text-2xl sm:text-3xl tracking-tight text-white">
						SmartByte<span class="text-emerald-400">KC</span>
					</span>
				</a>
				<p class="text-slate-400 text-sm max-w-md leading-relaxed">
					Friendly, expert IT consulting, network security, audio/video, and smart home support for residential and commercial spaces across the Kansas City metro.
				</p>
				<div class="pt-2 flex items-center gap-2 text-xs font-semibold text-emerald-400 bg-slate-900 border border-slate-800 px-3.5 py-2 rounded-full w-max">
					<ShieldCheck class="w-4 h-4 text-emerald-400" />
					<span>Licensed &amp; Insured Kansas City IT &amp; Low Voltage Services</span>
				</div>
			</div>

			<!-- Column 2: Quick Links -->
			<div class="space-y-3">
				<h4 class="font-heading font-bold text-xs uppercase tracking-wider text-slate-400">Services</h4>
				<ul class="space-y-2.5 text-sm text-slate-300">
					<li><a href="/services/network" class="hover:text-emerald-400 transition-colors">Network &amp; Security</a></li>
					<li><a href="/services/audio-video" class="hover:text-emerald-400 transition-colors">Audio &amp; Video Setup</a></li>
					<li><a href="/services/tech-support" class="hover:text-emerald-400 transition-colors">Tech Support &amp; Troubleshooting</a></li>
					<li><a href="/services/security" class="hover:text-emerald-400 transition-colors">Security Systems</a></li>
					<li><a href="/#contact" class="hover:text-emerald-400 transition-colors">Request Consultation</a></li>
				</ul>
			</div>

			<!-- Column 3: Contact & Service Area -->
			<div class="space-y-3">
				<h4 class="font-heading font-bold text-xs uppercase tracking-wider text-slate-400">Contact Us</h4>
				<div class="space-y-3 text-sm text-slate-300">
					<a href="tel:+19137035643" class="flex items-center gap-3 text-emerald-400 font-bold hover:underline text-base">
						<Phone class="w-4 h-4 shrink-0 text-emerald-400" />
						<span>(913) 703-5643</span>
					</a>
					<a href="mailto:Vince@SmartByteKC.com" class="flex items-center gap-3 hover:text-white transition-colors">
						<Mail class="w-4 h-4 shrink-0 text-emerald-400" />
						<span>Vince@SmartByteKC.com</span>
					</a>
					<div class="flex items-start gap-3">
						<MapPin class="w-4 h-4 shrink-0 text-emerald-400 mt-1" />
						<span class="text-xs text-slate-400">Serving Overland Park, Olathe, KCMO, Lee's Summit, Shawnee &amp; Greater KC Metro</span>
					</div>
				</div>
			</div>

		</div>

		<div class="pt-8 border-t border-slate-900 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
			<p>&copy; {new Date().getFullYear()} SmartByteKC / SmartByte Group, LLC. All rights reserved.</p>
			<div class="flex items-center gap-6">
				<a href="/#services" class="hover:text-slate-400">Services</a>
				<a href="/#why" class="hover:text-slate-400">Why Us</a>
				<a href="/#contact" class="hover:text-slate-400">Contact</a>
			</div>
		</div>
	</div>
</footer>

<!-- Floating Call Button for Mobile -->
<a 
	href="tel:+19137035643" 
	class="md:hidden fixed bottom-6 right-6 z-50 w-14 h-14 bg-emerald-500 text-slate-950 rounded-full flex items-center justify-center shadow-glow border border-emerald-400 active:scale-95 transition-all"
	aria-label="Call SmartByteKC"
>
	<Phone class="w-6 h-6" />
</a>
