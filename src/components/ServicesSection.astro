---
import { Shield, Wifi, Tv, Wrench, Building2, CheckCircle2, ArrowRight } from 'lucide-astro';

const services = [
	{
		id: "network-security",
		icon: Wifi,
		title: "Network & Security",
		tagline: "Rock-solid connectivity & 24/7 peace of mind",
		description: "Custom network engineering designed for zero dead zones, high bandwidth, and secure surveillance.",
		features: [
			"Wi-Fi 6E & 7 Mesh Networks",
			"Structured Cat6 / Cat6A Cabling",
			"4K IP Security Camera Systems & NVRs",
			"UniFi & Commercial Access Control",
			"Rack Cleanup & Cable Management"
		],
		link: "/services/network-security",
		badge: "Most Requested"
	},
	{
		id: "audio-video",
		icon: Tv,
		title: "Audio & Video",
		tagline: "Cinematic home theater & seamless sound",
		description: "Clean, wire-free TV mounts, high-fidelity audio systems, and smart control for any room or outdoor patio.",
		features: [
			"Concealed Wire TV Mounting & Soundbars",
			"Home Theater & Surround Sound",
			"Multi-Room & Architectural Speakers",
			"Outdoor & Weatherproof AV Systems",
			"HDMI Matrix & Commercial Signage"
		],
		link: "#contact"
	},
	{
		id: "tech-support",
		icon: Wrench,
		title: "Tech Support & On-Site Help",
		tagline: "Expert troubleshooting explained in plain English",
		description: "Hands-on tech support for home networks, smart home devices, server racks, and device migration.",
		features: [
			"On-Site Network & Wi-Fi Audits",
			"Smart Home Hub Setup (Apple/Google/Home Assistant)",
			"PC / Mac / Workstation Troubleshooting",
			"Data Migration & Backup Solutions",
			"Emergency On-Site Repair"
		],
		link: "#contact"
	},
	{
		id: "commercial",
		icon: Building2,
		title: "Commercial IT Infrastructure",
		tagline: "Turnkey infrastructure for Kansas City businesses",
		description: "Scalable cabling, access control, and network architecture built to keep your operations running smoothly.",
		features: [
			"Office Cable Drops & Server Racks",
			"Guest Wi-Fi & VLAN Segmentation",
			"Door Access Control Systems",
			"POS & Workstation Wiring",
			"Ongoing Managed IT Support"
		],
		link: "#contact"
	}
];
---

<section id="services" class="py-24 lg:py-32 bg-slate-950 border-b border-slate-900">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		
		<!-- Section Header -->
		<div class="text-center max-w-3xl mx-auto">
			<span class="text-xs sm:text-sm font-bold uppercase tracking-wider text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-3.5 py-1 rounded-full">
				What We Do
			</span>
			<h2 class="mt-4 font-heading text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
				Solutions engineered for your space.
			</h2>
			<p class="mt-4 text-lg text-slate-400">
				From a single room setup to full commercial infrastructure — we design, install, and support technology that fits your life and budget.
			</p>
		</div>

		<!-- Bento Grid -->
		<div class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-8">
			{services.map((service) => {
				const IconComponent = service.icon;
				return (
					<div class="bg-slate-900/70 rounded-3xl p-8 sm:p-10 border border-slate-800/80 hover:border-emerald-500/40 shadow-sm hover:shadow-glow transition-all duration-300 flex flex-col justify-between relative overflow-hidden group backdrop-blur-md">
						{service.badge && (
							<span class="absolute top-6 right-6 bg-emerald-500 text-slate-950 text-xs font-extrabold px-3 py-1 rounded-full uppercase tracking-wider shadow-sm">
								{service.badge}
							</span>
						)}
						<div>
							<!-- Icon Header -->
							<div class="w-14 h-14 rounded-2xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center mb-6 group-hover:scale-105 transition-transform duration-200 border border-emerald-500/20">
								<IconComponent class="w-7 h-7" />
							</div>

							<h3 class="font-heading text-2xl font-bold text-white">{service.title}</h3>
							<p class="text-sm font-semibold text-emerald-400 mt-1">{service.tagline}</p>
							<p class="mt-3 text-slate-400 text-base leading-relaxed">{service.description}</p>

							<!-- Feature Checklist -->
							<ul class="mt-6 space-y-2.5">
								{service.features.map((feature) => (
									<li class="flex items-center gap-3 text-sm text-slate-300 font-medium">
										<CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0" />
										<span>{feature}</span>
									</li>
								))}
							</ul>
						</div>

						<div class="mt-8 pt-6 border-t border-slate-800/80 flex items-center justify-between">
							<a 
								href={service.link} 
								class="inline-flex items-center gap-2 text-sm font-bold text-emerald-400 hover:text-emerald-300 transition-colors group-hover:translate-x-1 duration-200"
							>
								<span>Request details &amp; quote</span>
								<ArrowRight class="w-4 h-4" />
							</a>
						</div>
					</div>
				);
			})}
		</div>

	</div>
</section>
