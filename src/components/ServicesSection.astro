---
import { Shield, Wifi, Tv, Wrench, Building2, CheckCircle2, ArrowRight } from 'lucide-astro';

const services = [
	{
		id: "network-security",
		icon: Wifi,
		title: "Network & Security",
		tagline: "Rock-solid connectivity & 24/7 peace of mind",
		description: "Custom network engineering designed for zero dead zones, high bandwidth, and secure surveillance.",
		features: [
			"Wi-Fi 6E & 7 Mesh Networks",
			"Structured Cat6 / Cat6A Cabling",
			"4K IP Security Camera Systems & NVRs",
			"UniFi & Commercial Access Control",
			"Rack Cleanup & Cable Management"
		],
		badge: "Most Requested"
	},
	{
		id: "audio-video",
		icon: Tv,
		title: "Audio & Video",
		tagline: "Cinematic home theater & seamless sound",
		description: "Clean, wire-free TV mounts, high-fidelity audio systems, and smart control for any room or outdoor patio.",
		features: [
			"Concealed Wire TV Mounting & Soundbars",
			"Home Theater & Surround Sound",
			"Multi-Room & Architectural Speakers",
			"Outdoor & Weatherproof AV Systems",
			"HDMI Matrix & Commercial Signage"
		]
	},
	{
		id: "tech-support",
		icon: Wrench,
		title: "Tech Support & On-Site Help",
		tagline: "Expert troubleshooting explained in plain English",
		description: "Hands-on tech support for home networks, smart home devices, server racks, and device migration.",
		features: [
			"On-Site Network & Wi-Fi Audits",
			"Smart Home Hub Setup (Apple/Google/Home Assistant)",
			"PC / Mac / Workstation Troubleshooting",
			"Data Migration & Backup Solutions",
			"Emergency On-Site Repair"
		]
	},
	{
		id: "commercial",
		icon: Building2,
		title: "Commercial IT & Low Voltage",
		tagline: "Turnkey infrastructure for Kansas City businesses",
		description: "Scalable cabling, access control, and network architecture built to keep your operations running smoothly.",
		features: [
			"Office Cable Drops & Server Racks",
			"Guest Wi-Fi & VLAN Segmentation",
			"Door Access Control Systems",
			"POS & Workstation Wiring",
			"Ongoing Managed IT Support"
		]
	}
];
---

<section id="services" class="py-20 lg:py-32 bg-grayLight">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<!-- Section Header -->
		<div class="text-center max-w-3xl mx-auto">
			<span class="text-xs sm:text-sm font-bold uppercase tracking-wider text-brand-700 bg-brand-50 border border-brand-200 px-3.5 py-1 rounded-full">
				What We Do
			</span>
			<h2 class="mt-4 font-heading text-3xl sm:text-5xl font-extrabold text-dark tracking-tight">
				Solutions for every space.
			</h2>
			<p class="mt-4 text-lg text-grayMuted">
				From a single TV wall-mount to full commercial network cabling — we design, install, and support technology that fits your life and budget.
			</p>
		</div>

		<!-- Services Grid -->
		<div class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-8">
			{services.map((service) => {
				const IconComponent = service.icon;
				return (
					<div class="bg-white rounded-3xl p-8 sm:p-10 border border-gray-200/80 shadow-sm hover:shadow-md transition-all duration-300 flex flex-col justify-between relative overflow-hidden group">
						{service.badge && (
							<span class="absolute top-6 right-6 bg-brand-700 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">
								{service.badge}
							</span>
						)}
						<div>
							<!-- Icon Header -->
							<div class="w-14 h-14 rounded-2xl bg-brand-50 text-brand-700 flex items-center justify-center mb-6 group-hover:scale-105 transition-transform duration-200">
								<IconComponent class="w-7 h-7" />
							</div>

							<h3 class="font-heading text-2xl font-bold text-dark">{service.title}</h3>
							<p class="text-sm font-semibold text-brand-700 mt-1">{service.tagline}</p>
							<p class="mt-3 text-grayMuted text-base leading-relaxed">{service.description}</p>

							<!-- Feature Checklist -->
							<ul class="mt-6 space-y-2.5">
								{service.features.map((feature) => (
									<li class="flex items-center gap-3 text-sm text-dark/90 font-medium">
										<CheckCircle2 class="w-4 h-4 text-brand-600 shrink-0" />
										<span>{feature}</span>
									</li>
								))}
							</ul>
						</div>

						<div class="mt-8 pt-6 border-t border-gray-100 flex items-center justify-between">
							<a 
								href="#estimator" 
								class="inline-flex items-center gap-2 text-sm font-bold text-brand-700 hover:text-brand-800 transition-colors"
							>
								<span>Estimate this service</span>
								<ArrowRight class="w-4 h-4" />
							</a>
						</div>
					</div>
				);
			})}
		</div>
	</div>
</section>
