---
import { ShieldCheck, Wifi, Tv, Wrench, Building2, CheckCircle2, ArrowRight } from 'lucide-astro';

const services = [
	{
		id: "network",
		icon: Wifi,
		title: "Network Solutions",
		tagline: "High-performance WiFi & Infrastructure",
		description: "Custom network engineering designed for zero dead zones and high bandwidth.",
		badge: "Most Requested",
		link: "/services/network"
	},
	{
		id: "security",
		icon: ShieldCheck,
		title: "Security Systems",
		tagline: "Surveillance & Peace of Mind",
		description: "Reliable 4K IP security cameras and smart access control for total protection.",
		link: "/services/security"
	},
	{
		id: "audio-video",
		icon: Tv,
		title: "Audio / Video",
		tagline: "Cinematic home theater & seamless sound",
		description: "Clean TV mounts, high-fidelity audio, and smart control for any space.",
		link: "/services/audio-video"
	},
	{
		id: "tech-support",
		icon: Wrench,
		title: "Tech Support",
		tagline: "Fast & friendly troubleshooting",
		description: "Expert help for home networks, smart devices, and workstation setups.",
		link: "/services/tech-support"
	}
];
---
<section id="services" class="py-24 lg:py-32 bg-slate-950 border-b border-slate-900">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="text-center max-w-3xl mx-auto">
			<span class="text-xs sm:text-sm font-bold uppercase tracking-wider text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-3.5 py-1 rounded-full">
				Our Services
			</span>
			<h2 class="mt-4 font-heading text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
				Solutions engineered for your space.
			</h2>
		</div>
		<div class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-8">
			{services.map((service) => {
				const IconComponent = service.icon;
				return (
					<div class="bg-slate-900/70 rounded-3xl p-8 sm:p-10 border border-slate-800/80 hover:border-emerald-500/40 shadow-sm hover:shadow-glow transition-all flex flex-col justify-between relative group backdrop-blur-md">
						{service.badge && (
							<span class="absolute top-6 right-6 bg-emerald-500 text-slate-950 text-xs font-extrabold px-3 py-1 rounded-full uppercase tracking-wider">
								{service.badge}
							</span>
						)}
						<div>
							<div class="w-14 h-14 rounded-2xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center mb-6 group-hover:scale-105 transition-transform border border-emerald-500/20">
								<IconComponent class="w-7 h-7" />
							</div>
							<h3 class="font-heading text-2xl font-bold text-white">{service.title}</h3>
							<p class="text-sm font-semibold text-emerald-400 mt-1">{service.tagline}</p>
							<p class="mt-3 text-slate-400 text-base leading-relaxed">{service.description}</p>
						</div>
						<div class="mt-8 pt-6 border-t border-slate-800/80">
							<a href={service.link} class="inline-flex items-center gap-2 text-sm font-bold text-emerald-400 hover:text-emerald-300 transition-colors group-hover:translate-x-1">
								<span>View Details & Request Quote</span>
								<ArrowRight class="w-4 h-4" />
							</a>
						</div>
					</div>
				);
			})}
		</div>
	</div>
</section>