---
import Logo from './Logo.astro';
import { Phone, Menu, X, ArrowRight, ChevronDown } from 'lucide-astro';
---
<header class="sticky top-0 z-50 bg-slate-950/90 backdrop-blur-xl border-b border-slate-800/80 transition-all duration-300">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 sm:h-24 flex items-center justify-between">
		<!-- Brand Logo -->
		<a href="/" class="flex items-center gap-4 group">
			<div class="w-16 h-16 sm:w-20 sm:h-20 text-emerald-400 flex items-center justify-center">
				<Logo class="w-full h-full" />
			</div>
			<span class="font-heading font-extrabold text-2xl sm:text-3xl tracking-tight text-white">
				SmartByte<span class="text-emerald-400">KC</span>
			</span>
		</a>

		<!-- Desktop Nav -->
		<nav class="hidden md:flex items-center gap-8 font-semibold text-base text-slate-300">
			<div class="relative group">
				<button class="flex items-center gap-1 hover:text-emerald-400 transition-colors">
					Services <ChevronDown class="w-4 h-4" />
				</button>
				<div class="absolute left-0 top-full mt-2 w-56 bg-slate-900 border border-slate-800 rounded-2xl shadow-xl p-2 hidden group-hover:block">
					<a href="/services/network" class="block px-4 py-3 rounded-lg hover:bg-slate-800 hover:text-emerald-400">Network</a>
					<a href="/services/security" class="block px-4 py-3 rounded-lg hover:bg-slate-800 hover:text-emerald-400">Security</a>
					<a href="/services/audio-video" class="block px-4 py-3 rounded-lg hover:bg-slate-800 hover:text-emerald-400">Audio / Video</a>
					<a href="/services/tech-support" class="block px-4 py-3 rounded-lg hover:bg-slate-800 hover:text-emerald-400">Tech Support</a>
				</div>
			</div>
			<a href="#why" class="hover:text-emerald-400 transition-colors">Why Us</a>
			<a href="#contact" class="hover:text-emerald-400 transition-colors">Contact</a>
		</nav>

		<!-- CTAs -->
		<div class="hidden md:flex items-center gap-6">
			<a href="tel:+1917035643" class="flex items-center gap-2.5 text-emerald-400 font-bold hover:text-emerald-300 transition-colors">
				<Phone class="w-5 h-5" />
				<span>(913) 703-5643</span>
			</a>
			<a href="#contact" class="bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-extrabold px-6 py-3 rounded-full transition-all shadow-glow flex items-center gap-2">
				Contact
			</a>
		</div>
	</div>
</header>