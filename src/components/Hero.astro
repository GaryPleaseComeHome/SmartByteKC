---
import Logo from './Logo.astro';
import { Phone, ArrowRight, ShieldCheck, Wifi, Tv, Wrench, Sparkles, Cpu } from 'lucide-astro';
---

<section class="relative overflow-hidden bg-slate-950 py-20 sm:py-28 lg:py-36 border-b border-slate-900">
	<!-- Ambient Background Glows & Grid -->
	<div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(16,185,129,0.18),rgba(255,255,255,0))] pointer-events-none"></div>
	<div class="absolute inset-0 bg-[linear-gradient(to_right,#1e293b15_1px,transparent_1px),linear-gradient(to_bottom,#1e293b15_1px,transparent_1px)] bg-[size:40px_40px] pointer-events-none"></div>

	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
		
		<!-- Location Badge -->
		<div class="inline-flex items-center gap-2.5 bg-slate-900/90 border border-emerald-500/30 px-4 py-1.5 rounded-full text-emerald-400 text-xs sm:text-sm font-semibold tracking-wide mb-8 shadow-glow backdrop-blur-md">
			<Sparkles class="w-4 h-4 text-emerald-400 animate-pulse" />
			<span>Kansas City Metro — Residential & Commercial IT</span>
		</div>

		<!-- Main Headline -->
		<h1 class="font-heading text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white max-w-4xl mx-auto leading-[1.1]">
			Smart Technology.<br/>
			<span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-emerald-500">
				Simplified.
			</span>
		</h1>

		<!-- Subheadline -->
		<p class="mt-6 text-lg sm:text-xl lg:text-2xl text-slate-400 max-w-2xl mx-auto font-normal leading-relaxed">
			Network security, Cat6 cabling, smart audio/video, and hands-on tech support — installed, explained, and built right for Kansas City homes and businesses.
		</p>

		<!-- Hero CTAs -->
		<div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center items-center max-w-md mx-auto sm:max-w-none">
			<a 
				href="tel:+19137035643" 
				class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-heading font-bold text-lg px-8 py-4 rounded-full shadow-glow hover:shadow-glow-lg transition-all duration-200 transform hover:-translate-y-0.5"
			>
				<Phone class="w-5 h-5" />
				<span>Call Now: (913) 703-5643</span>
			</a>
			<a 
				href="#contact" 
				class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-slate-900/80 hover:bg-slate-800 text-white font-heading font-semibold text-lg px-8 py-4 rounded-full border border-slate-700/80 transition-all duration-200 backdrop-blur-md"
			>
				<span>Request Consultation</span>
				<ArrowRight class="w-5 h-5 text-emerald-400" />
			</a>
		</div>

		<!-- Bento Pill Highlights -->
		<div class="mt-16 pt-8 border-t border-slate-800/80 grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto">
			<div class="flex items-center justify-center gap-2.5 text-xs sm:text-sm font-medium text-slate-300 bg-slate-900/60 p-3.5 rounded-2xl border border-slate-800 backdrop-blur-md">
				<Wifi class="w-4 h-4 text-emerald-400" />
				<span>Wi-Fi 6E/7 Networks</span>
			</div>
			<div class="flex items-center justify-center gap-2.5 text-xs sm:text-sm font-medium text-slate-300 bg-slate-900/60 p-3.5 rounded-2xl border border-slate-800 backdrop-blur-md">
				<ShieldCheck class="w-4 h-4 text-emerald-400" />
				<span>Cat6 & 4K Cameras</span>
			</div>
			<div class="flex items-center justify-center gap-2.5 text-xs sm:text-sm font-medium text-slate-300 bg-slate-900/60 p-3.5 rounded-2xl border border-slate-800 backdrop-blur-md">
				<Tv class="w-4 h-4 text-emerald-400" />
				<span>Audio & Video Systems</span>
			</div>
			<div class="flex items-center justify-center gap-2.5 text-xs sm:text-sm font-medium text-slate-300 bg-slate-900/60 p-3.5 rounded-2xl border border-slate-800 backdrop-blur-md">
				<Wrench class="w-4 h-4 text-emerald-400" />
				<span>Local Tech Support</span>
			</div>
		</div>

	</div>
</section>
