---
import { Phone, ArrowRight, Sparkles, Wifi, ShieldCheck, Tv, Wrench } from 'lucide-astro';
---
<section class="relative overflow-hidden bg-slate-950 py-20 sm:py-28 lg:py-36 border-b border-slate-900">
	<div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(16,185,129,0.18),rgba(255,255,255,0))] pointer-events-none"></div>
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
		<!-- Location Badge -->
		<div class="inline-flex items-center gap-2.5 bg-slate-900/90 border border-emerald-500/30 px-4 py-1.5 rounded-full text-emerald-400 text-xs sm:text-sm font-semibold tracking-wide mb-8 shadow-glow backdrop-blur-md">
			<Sparkles class="w-4 h-4 text-emerald-400 animate-pulse" />
			<span>Kansas City Metro — Residential & Commercial IT</span>
		</div>

		<!-- Main Headline -->
		<h1 class="font-heading text-5xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white max-w-4xl mx-auto leading-[1.1]">
			Smart Technology.<br/>
			<span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-emerald-500">
				Simplified.
			</span>
		</h1>

		<!-- Professional Paragraph -->
		<p class="mt-8 text-lg sm:text-xl lg:text-2xl text-slate-300 max-w-3xl mx-auto font-medium leading-relaxed">
			Expert IT, network security, and smart home integration. We provide professional installation, clear guidance, and trusted local support for Kansas City homes and businesses.
		</p>

		<!-- Hero CTAs -->
		<div class="mt-12 flex flex-col sm:flex-row gap-4 justify-center items-center max-w-md mx-auto sm:max-w-none">
			<a href="tel:+1917035643" class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-heading font-black text-xl px-10 py-5 rounded-full shadow-glow transition-all duration-200 transform hover:-translate-y-0.5">
				<Phone class="w-6 h-6" />
				<span>Call Now: (913) 703-5643</span>
			</a>
			<a href="/#contact" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-slate-900/80 hover:bg-slate-800 text-white font-heading font-bold text-xl px-10 py-5 rounded-full border border-slate-700/80 transition-all backdrop-blur-md">
				<span>Request Consultation</span>
				<ArrowRight class="w-6 h-6 text-emerald-400" />
			</a>
		</div>

		<!-- Grid Pills -->
		<div class="mt-20 pt-10 border-t border-slate-800/80 grid grid-cols-2 md:grid-cols-4 gap-5 max-w-5xl mx-auto">
			{[
				{ icon: Wifi, text: "WiFi / Networks" },
				{ icon: ShieldCheck, text: "Security Cameras / Systems" },
				{ icon: Tv, text: "Audio / Video" },
				{ icon: Wrench, text: "Local Tech Support" }
			].map(item => (
				<div class="flex items-center justify-center gap-3 text-xs sm:text-sm lg:text-base font-bold text-slate-200 bg-slate-900/60 p-4 rounded-2xl border border-slate-800 backdrop-blur-md">
					<item.icon class="w-5 h-5 text-emerald-400 shrink-0" />
					<span>{item.text}</span>
				</div>
			))}
		</div>
	</div>
</section>