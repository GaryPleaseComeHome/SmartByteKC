---
import { Phone, Calculator, CheckCircle2, ShieldCheck, Wifi, Tv, Wrench } from 'lucide-astro';
---

<section class="relative overflow-hidden bg-gradient-to-b from-gray-50 via-white to-white py-16 sm:py-24 lg:py-32">
	<!-- Subtle Background Grid Pattern -->
	<div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:32px_32px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] pointer-events-none"></div>

	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
		<!-- Location Badge -->
		<div class="inline-flex items-center gap-2 bg-brand-50 border border-brand-200/80 px-4 py-1.5 rounded-full text-brand-700 text-xs sm:text-sm font-semibold tracking-wide mb-8 shadow-sm">
			<ShieldCheck class="w-4 h-4 text-brand-600" />
			<span>Kansas City Metro — Residential & Commercial IT</span>
		</div>

		<!-- Main Headline -->
		<h1 class="font-heading text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-dark max-w-4xl mx-auto leading-[1.1]">
			Technology that just <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-700 to-brand-500">works.</span>
		</h1>

		<!-- Subheadline -->
		<p class="mt-6 text-lg sm:text-xl lg:text-2xl text-grayMuted max-w-2xl mx-auto font-normal leading-relaxed">
			Network infrastructure, security cameras, audio/video, and hands-on IT support — engineered with precision for Kansas City homes & businesses.
		</p>

		<!-- CTAs -->
		<div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center items-center max-w-md mx-auto sm:max-w-none">
			<a 
				href="tel:+19137035643" 
				class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-brand-700 hover:bg-brand-600 text-white font-heading font-bold text-lg px-8 py-4 rounded-full shadow-lg shadow-brand-700/25 hover:shadow-brand-700/40 transition-all duration-200 transform hover:-translate-y-0.5"
			>
				<Phone class="w-5 h-5" />
				<span>Call Now: (913) 703-5643</span>
			</a>
			<a 
				href="#estimator" 
				class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-grayLight hover:bg-gray-200 text-dark font-heading font-semibold text-lg px-8 py-4 rounded-full border border-gray-300/80 transition-all duration-200"
			>
				<Calculator class="w-5 h-5 text-brand-700" />
				<span>Build an Estimate</span>
			</a>
		</div>

		<!-- Feature Badges -->
		<div class="mt-16 pt-8 border-t border-gray-100 grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto">
			<div class="flex items-center justify-center gap-2 text-sm font-medium text-dark/80 bg-white p-3 rounded-2xl border border-gray-100 shadow-sm">
				<Wifi class="w-4 h-4 text-brand-600" />
				<span>Wi-Fi 6E/7 Mesh</span>
			</div>
			<div class="flex items-center justify-center gap-2 text-sm font-medium text-dark/80 bg-white p-3 rounded-2xl border border-gray-100 shadow-sm">
				<ShieldCheck class="w-4 h-4 text-brand-600" />
				<span>Cat6 / 4K Cameras</span>
			</div>
			<div class="flex items-center justify-center gap-2 text-sm font-medium text-dark/80 bg-white p-3 rounded-2xl border border-gray-100 shadow-sm">
				<Tv class="w-4 h-4 text-brand-600" />
				<span>TV & Home Theater</span>
			</div>
			<div class="flex items-center justify-center gap-2 text-sm font-medium text-dark/80 bg-white p-3 rounded-2xl border border-gray-100 shadow-sm">
				<Wrench class="w-4 h-4 text-brand-600" />
				<span>Local Tech Support</span>
			</div>
		</div>
	</div>
</section>
