---
import { ShieldCheck, Cpu, HeartHandshake, MapPin } from 'lucide-astro';

const points = [
	{
		icon: HeartHandshake,
		title: "We Explain, Never Confuse",
		description: "Technology shouldn't feel like black magic. We break down every recommendation in plain English — so you know exactly what you're paying for and why."
	},
	{
		icon: Cpu,
		title: "Control Systems Discipline",
		description: "Built on an engineering background in industrial control systems. We design with precision, plan for future upgrades, and install hardware that stands the test of time."
	},
	{
		icon: MapPin,
		title: "100% Local Kansas City Service",
		description: "We are your local Kansas City neighbors, not a distant call center. Expect fast response times, direct communication, and accountable local craftsmanship."
	}
];
---

<section id="why" class="py-20 lg:py-32 bg-grayLight border-t border-gray-200/60">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<!-- Section Header -->
		<div class="text-center max-w-3xl mx-auto">
			<span class="text-xs sm:text-sm font-bold uppercase tracking-wider text-brand-700 bg-brand-50 border border-brand-200 px-3.5 py-1 rounded-full">
				The SmartByteKC Difference
			</span>
			<h2 class="mt-4 font-heading text-3xl sm:text-5xl font-extrabold text-dark tracking-tight">
				Tech that makes sense. Service you can count on.
			</h2>
		</div>

		<!-- Points Grid -->
		<div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-8">
			{points.map((pt) => {
				const IconComp = pt.icon;
				return (
					<div class="bg-white rounded-3xl p-8 border border-gray-200/80 shadow-sm hover:shadow-md transition-all duration-300">
						<div class="w-12 h-12 rounded-2xl bg-brand-50 text-brand-700 flex items-center justify-center mb-6">
							<IconComp class="w-6 h-6" />
						</div>
						<h3 class="font-heading text-xl font-bold text-dark mb-3">{pt.title}</h3>
						<p class="text-grayMuted text-base leading-relaxed">{pt.description}</p>
					</div>
				);
			})}
		</div>
	</div>
</section>
