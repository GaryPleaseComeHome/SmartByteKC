---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---
<svg class={className} viewBox="0 0 100 100" fill="none" stroke="currentColor" xmlns="http://www.w3.org/2000/svg">
  <!-- Minimalist Brain Profile -->
  <path d="M65 30c-15 0-25 10-25 25s10 25 25 25 25-15 25-25-10-25-25-25z" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M50 40c-5 0-8 5-8 10s3 10 8 10 8-5 8-10-3-10-8-10z" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
  <!-- Simplified USB Type-A Stem -->
  <rect x="20" y="45" width="12" height="22" rx="2" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
  <rect x="23" y="50" width="6" height="6" rx="1" fill="currentColor"/>
</svg>