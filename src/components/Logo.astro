---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---
<svg class={className} viewBox="0 0 100 100" fill="none" stroke="currentColor" xmlns="http://www.w3.org/2000/svg">
  <!-- Simplified Sideways Brain Profile -->
  <path d="M60 30c-12 0-20 8-20 20s8 20 20 20 20-8 20-20-8-20-20-20z" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M50 35c-5 0-8 5-8 10s3 10 8 10 8-5 8-10-3-10-8-10z" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
  <!-- Distinct USB Type-A Plug -->
  <rect x="15" y="40" width="15" height="20" rx="3" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
  <rect x="20" y="45" width="5" height="10" rx="1" fill="currentColor"/>
</svg>