---
interface Props {
	class?: string;
}

const { class: className = "w-8 h-8" } = Astro.props;
---

<svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" class={className}>
	<!-- Brain Left Lobe -->
	<path 
		d="M32 10C24 10 17 15.5 17 23.5C17 26.8 18.3 29.8 20.5 32C18.5 33.8 17 36.5 17 39.5C17 44.5 21 48.5 26 48.5H32" 
		stroke="currentColor" 
		stroke-width="3.5" 
		stroke-linecap="round" 
		stroke-linejoin="round"
	/>
	<!-- Brain Right Lobe -->
	<path 
		d="M32 10C40 10 47 15.5 47 23.5C47 26.8 45.7 29.8 43.5 32C45.5 33.8 47 36.5 47 39.5C47 44.5 43 48.5 38 48.5H32" 
		stroke="currentColor" 
		stroke-width="3.5" 
		stroke-linecap="round" 
		stroke-linejoin="round"
	/>
	<!-- Center Stem Fissure -->
	<path d="M32 10V48.5" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
	
	<!-- Circuit Neural Waves (Left & Right) -->
	<path d="M23 20C27 22 32 22 32 22" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
	<path d="M41 20C37 22 32 22 32 22" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
	<path d="M22 31C27 33 32 33 32 33" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
	<path d="M42 31C37 33 32 33 32 33" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
	<path d="M24 40C28 41.5 32 41.5 32 41.5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
	<path d="M40 40C36 41.5 32 41.5 32 41.5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
	
	<!-- USB Stem Base Connector -->
	<rect x="24" y="48.5" width="16" height="8" rx="2" fill="currentColor"/>
	<!-- USB Pins -->
	<rect x="27.5" y="56.5" width="3" height="4.5" rx="0.5" fill="currentColor"/>
	<rect x="33.5" y="56.5" width="3" height="4.5" rx="0.5" fill="currentColor"/>
</svg>
