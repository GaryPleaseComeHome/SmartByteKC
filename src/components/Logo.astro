---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---
<svg class={className} viewBox="0 0 64 64" fill="none" stroke="currentColor" xmlns="http://www.w3.org/2000/svg">
  <!-- Brain Profile (Sideways) -->
  <path d="M44 16c-10 0-18 6-18 18s8 18 18 18 18-9 18-18-8-18-18-18z" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M44 22c-4 0-8 4-8 8s4 8 8 8 8-4 8-8-4-8-8-8z" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
  <!-- USB Type-A Stem (Simplified) -->
  <rect x="24" y="44" width="12" height="16" rx="2" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
  <rect x="28" y="48" width="4" height="6" rx="0.5" fill="currentColor"/>
</svg>