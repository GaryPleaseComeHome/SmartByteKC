---
import { Phone, Mail, MapPin, Send, CheckCircle2, ShieldCheck } from 'lucide-astro';
---

<section id="contact" class="py-24 lg:py-32 bg-slate-950">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
			
			<!-- Left Column: Info & Phone -->
			<div class="lg:col-span-5 space-y-8">
				<div>
					<span class="text-xs sm:text-sm font-bold uppercase tracking-wider text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-3.5 py-1 rounded-full">
						Get In Touch
					</span>
					<h2 class="mt-4 font-heading text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
						Ready to get started?
					</h2>
					<p class="mt-4 text-slate-400 text-base sm:text-lg leading-relaxed">
						Give Vince a call to discuss your project directly, or fill out the form and we'll follow up promptly with options and pricing.
					</p>
				</div>

				<!-- Phone Hero Card -->
				<div class="bg-gradient-to-br from-emerald-950/80 to-slate-900 border border-emerald-500/30 rounded-3xl p-8 shadow-glow backdrop-blur-md">
					<div class="text-xs uppercase font-bold text-emerald-400 tracking-wider">Direct Phone Support</div>
					<a href="tel:+19137035643" class="mt-2 block font-heading text-3xl sm:text-4xl font-extrabold text-white hover:text-emerald-300 transition-colors">
						(913) 703-5643
					</a>
					<p class="text-xs text-slate-400 mt-2">Available Mon–Sat • On-Site Appointments Across KC Metro</p>
				</div>

				<!-- Contact Details -->
				<div class="space-y-4 pt-2">
					<div class="flex items-center gap-4 text-slate-300">
						<div class="w-10 h-10 rounded-xl bg-slate-900 text-emerald-400 flex items-center justify-center border border-slate-800 shrink-0">
							<Mail class="w-5 h-5" />
						</div>
						<div>
							<div class="text-xs text-slate-400">Email Address</div>
							<a href="mailto:Vince@SmartByteKC.com" class="text-sm font-bold text-white hover:text-emerald-400 transition-colors">
								Vince@SmartByteKC.com
							</a>
						</div>
					</div>

					<div class="flex items-center gap-4 text-slate-300">
						<div class="w-10 h-10 rounded-xl bg-slate-900 text-emerald-400 flex items-center justify-center border border-slate-800 shrink-0">
							<MapPin class="w-5 h-5" />
						</div>
						<div>
							<div class="text-xs text-slate-400">Service Coverage</div>
							<div class="text-sm font-semibold text-white">Overland Park, Olathe, KCMO, Lee's Summit &amp; Metro</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Right Column: Consultation Form -->
			<div class="lg:col-span-7 bg-slate-900/90 rounded-3xl p-8 sm:p-10 border border-slate-800 shadow-xl backdrop-blur-md">
				<h3 class="font-heading text-2xl font-bold text-white mb-2">Request a Free Consultation</h3>
				<p class="text-sm text-slate-400 mb-8">Tell us about your home or business technology needs.</p>

				<form id="contact-form" class="space-y-5">
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
						<div>
							<label for="contact-name" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">Your Name *</label>
							<input type="text" id="contact-name" name="name" required placeholder="John Smith" class="w-full p-3.5 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 text-sm focus:border-emerald-500 focus:outline-none transition-colors" />
						</div>
						<div>
							<label for="contact-phone" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">Phone Number *</label>
							<input type="tel" id="contact-phone" name="phone" required placeholder="(913) 555-0123" class="w-full p-3.5 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 text-sm focus:border-emerald-500 focus:outline-none transition-colors" />
						</div>
					</div>

					<div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
						<div>
							<label for="contact-email" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">Email Address</label>
							<input type="email" id="contact-email" name="email" placeholder="john@example.com" class="w-full p-3.5 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 text-sm focus:border-emerald-500 focus:outline-none transition-colors" />
						</div>
						<div>
							<label for="contact-interest" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">Service Interest *</label>
							<select id="contact-interest" name="interest" required class="w-full p-3.5 rounded-xl bg-slate-950 border border-slate-800 text-white text-sm focus:border-emerald-500 focus:outline-none transition-colors">
								<option value="" disabled selected>Choose a service…</option>
								<option value="network-security">Network &amp; Security / Cabling</option>
								<option value="audio-video">Audio &amp; Video / TV Mounting</option>
								<option value="tech-support">Tech Support &amp; Troubleshooting</option>
								<option value="commercial">Commercial Business Project</option>
								<option value="other">Other / Not Sure</option>
							</select>
						</div>
					</div>

					<div>
						<label for="contact-message" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">Project Details</label>
						<textarea id="contact-message" name="message" rows="4" placeholder="Briefly describe what you'd like done (e.g. Wi-Fi setup, TV wall mount, Cat6 ethernet drops)..." class="w-full p-3.5 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 text-sm focus:border-emerald-500 focus:outline-none transition-colors"></textarea>
					</div>

					<button type="submit" class="w-full bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-heading font-bold py-4 rounded-xl shadow-glow hover:shadow-glow-lg transition-all flex items-center justify-center gap-2 text-base">
						<Send class="w-5 h-5" />
						<span>Send Message</span>
					</button>
				</form>

				<!-- Success Alert -->
				<div id="contact-success" class="hidden mt-6 p-6 bg-emerald-500/10 border border-emerald-500/30 rounded-2xl text-center">
					<CheckCircle2 class="w-12 h-12 text-emerald-400 mx-auto mb-3" />
					<h4 class="font-heading text-lg font-bold text-white">Message Received!</h4>
					<p class="text-sm text-slate-300 mt-1">Vince will review your details and be in touch shortly. Need immediate help?</p>
					<a href="tel:+19137035643" class="mt-4 inline-flex items-center gap-2 bg-emerald-500 text-slate-950 font-bold text-xs px-5 py-2.5 rounded-full">
						Call (913) 703-5643
					</a>
				</div>

			</div>

		</div>

	</div>
</section>

<script>
	const form = document.getElementById('contact-form');
	const successAlert = document.getElementById('contact-success');

	if (form) {
		form.addEventListener('submit', (e) => {
			e.preventDefault();
			const name = (document.getElementById('contact-name') as HTMLInputElement).value;
			const phone = (document.getElementById('contact-phone') as HTMLInputElement).value;

			if (!name || !phone) {
				alert('Please fill out your Name and Phone Number.');
				return;
			}

			form.classList.add('hidden');
			if (successAlert) successAlert.classList.remove('hidden');
		});
	}
</script>
